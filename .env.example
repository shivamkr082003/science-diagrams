# Copy this file to .env.local and fill in your own values.
# Never commit .env.local — it is ignored by git.

# Free key from https://aistudio.google.com/api-keys
GEMINI_API_KEY=

# Optional: which Gemini model to use (default: gemini-3.5-flash-lite)
GEMINI_MODEL=gemini-3.5-flash-lite

# Optional: Upstash Redis REST credentials for saving approve/reject.
# If empty, reviews are saved to data/reviews.json (local dev only).
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
